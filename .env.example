# Copy to .env (git-ignored) and fill in.

# Prefix of every runner name on GitHub: [a-z0-9], no dash, unique per host. The manager's GC
# deletes offline registrations carrying this prefix, so two hosts must never share it.
RUNNER_NAME_PREFIX=ci1

# --- GitHub credentials, first match wins for each org -------------------------------------------

# 1. A token for one org. Variable name: GITHUB_TOKEN_ + org upper-cased, non-alphanumerics as _.
#    Fine-grained PAT, resource owner = the org, organization permission
#    "Self-hosted runners: Read and write" (nothing else). Or a classic PAT with admin:org.
# GITHUB_TOKEN_ACME=github_pat_...
# GITHUB_TOKEN_OTHER_ORG=github_pat_...

# 2. A GitHub App installed on the orgs, organization permission "Self-hosted runners: Read and
#    write". Its private key goes to secrets/github-app.pem. An App installable on several orgs
#    must be public ("Any account"): that only lets an org install it, not use your installations.
# GITHUB_APP_ID=123456

# 3. One token for every org: classic PAT with admin:org (broad; prefer 1 or 2).
# GITHUB_TOKEN=ghp_...

# --- Optional ------------------------------------------------------------------------------------
# RUNNER_VERSION=latest        # tag of ghcr.io/actions/actions-runner the image builds from
# RUNNER_IMAGE=gha-runner:local
# TICK_SECONDS=10              # reconcile period
# GC_MINUTES=10                # orphan registration sweep period
# DRAIN_SECONDS=300            # on stop, time busy runners get to finish (keep < stop_grace_period)
# GITHUB_API_URL=https://api.github.com
